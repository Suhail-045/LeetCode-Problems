class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        ListNode x = head;
        ListNode y = head;
        for(int i=0;i<n;i++) {
            y = y.next;
        }
        if(y==null) {
            // when size and n are equal
            return  head.next;
        }
        while(y.next != null) {
            x = x.next;
            y = y.next;
        }
        x.next = x.next.next;
        return head;
    }
}
